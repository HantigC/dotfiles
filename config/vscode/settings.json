  "git.openRepositoryInParentFolders": "never",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "files.associations": {
    "*.cu": "cpp",
    "*.cuh": "cpp"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "clangd.detectExtensionConflicts": false,
  "remote.autoForwardPortsSource": "hybrid",
  "window.menuBarVisibility": "compact",
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],
  "workbench.editorAssociations": {
    "*.db": "sqlite-viewer.option"
  },
  "sqliteViewer.maxFileSize": 2000,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "redhat.telemetry.enabled": false,
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "cmake.showOptionsMovedNotification": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.lineNumbers": "relative",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[cmake]": {
    "editor.defaultFormatter": "cheshirekow.cmake-format"
  },
  "git.blame.editorDecoration.enabled": false,
  "git.blame.statusBarItem.enabled": true,
  "mdb.mcp.server": "prompt",
  "sonarlint.automaticAnalysis": true,
  "python.analysis.generateWithTypeAnnotation": true,
  "terminal.integrated.fontFamily": "monospace",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "workbench.colorTheme": "Theme Darker",
  "diffEditor.ignoreTrimWhitespace": false,
}