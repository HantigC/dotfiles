{
  // Analog of vscode "Theme Darker" (a VS Code-only extension theme) — swap
  // for any installed theme, e.g. "One Dark", "Gruvbox Dark", "Catppuccin Mocha".
  "theme": "One Dark",

  "vim_mode": true,
  "cursor_blink": true,
  "cursor_shape": "bar",
  "relative_line_numbers": "enabled",

  "buffer_font_family": "Fira Code",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": true // ligatures
  },

  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "never"
  },
  "indent_guides": {
    "enabled": false
  },
  "tab_bar": {
    "show": true
  },
  "soft_wrap": "none",
  "scroll_beyond_last_line": "off",
  "cursor_surrounding_lines": 10,

  // Extensions to install automatically on launch (replaces vscode's
  // `code --install-extension` loop; language servers for python/rust/cpp
  // are handled natively by Zed and don't need an extension entry here).
  "auto_install_extensions": {
    "toml": true,
    "latex": true,
    "sql": true,
    "rst": true,
    "neocmake": true
  },

  "languages": {
    "Python": {
      "tab_size": 4,
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "format_on_save": "on"
    },
    "Shell Script": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "Rust": {
      "format_on_save": "on"
    }
  },

  "git": {
    "inline_blame": {
      "enabled": false
    }
  }
}
